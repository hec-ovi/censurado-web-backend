{{define "login"}}<!doctype html>
<html lang="{{.Lang}}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{.Title}} | {{T "Admin Panel"}}</title>
<link rel="stylesheet" href="/admin/assets/admin.css">
<script src="/admin/assets/theme.js" defer></script>
<script src="/admin/assets/lang.js" defer></script>
</head>
<body class="admin-body admin-login-body">
<main class="admin-login-card">
<div class="admin-login-head">
<span class="admin-mark">AP</span>
<div>
<p class="admin-kicker">{{T "Control panel"}}</p>
<h1 class="admin-login-title">{{T "Admin Panel"}}</h1>
</div>
</div>
<div class="admin-login-theme-row">
<div class="admin-theme-switch" role="group" aria-label="{{T "Theme"}}">
<button type="button" class="admin-theme-option" data-theme-choice="system" aria-pressed="true">{{T "System"}}</button>
<button type="button" class="admin-theme-option" data-theme-choice="light" aria-pressed="false">{{T "Light"}}</button>
<button type="button" class="admin-theme-option" data-theme-choice="dark" aria-pressed="false">{{T "Dark"}}</button>
</div>
<div class="admin-lang-switch" role="group" aria-label="{{T "Language"}}">
<button type="button" class="admin-lang-option" data-lang-choice="en" aria-pressed="{{if eq .Lang "en"}}true{{else}}false{{end}}">EN</button>
<button type="button" class="admin-lang-option" data-lang-choice="es" aria-pressed="{{if eq .Lang "es"}}true{{else}}false{{end}}">ES</button>
</div>
</div>
{{if .Error}}<p class="admin-error" role="alert">{{T .Error}}</p>{{end}}
<form class="admin-login-form" method="post" action="/admin/login">
<label class="admin-label" for="token">{{T "Operator token"}}</label>
<input class="admin-input" id="token" name="token" type="password" autocomplete="current-password" value="{{.Token}}" autofocus required>
<button class="admin-btn" type="submit">{{T "Sign in"}}</button>
</form>
</main>
</body>
</html>
{{end}}

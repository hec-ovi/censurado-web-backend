{{define "layout"}}<!doctype html>
<html lang="{{.Lang}}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{.Title}} | {{T "Admin Panel"}}</title>
<meta name="csrf-token" content="{{.CSRFToken}}">
<link rel="stylesheet" href="/admin/assets/admin.css">
<script src="/admin/assets/htmx.min.js" defer></script>
<script src="/admin/assets/theme.js" defer></script>
<script src="/admin/assets/lang.js" defer></script>
</head>
<body class="admin-body">
<div class="admin-shell">
<aside class="admin-sidebar" aria-label="{{T "Primary"}}">
<a class="admin-brand" href="/admin/articles"><span class="admin-mark">AP</span><span>{{T "Admin Panel"}}</span></a>
{{if .CSRFToken}}
<nav class="admin-nav" aria-label="{{T "Sections"}}">
<a class="admin-nav-link" href="/admin/articles">{{T "Dashboard"}}</a>
<a class="admin-nav-link" href="/admin/create">{{T "Create"}}</a>
{{if .AuthorsEnabled}}<a class="admin-nav-link" href="/admin/authors">{{T "Authors"}}</a>{{end}}
{{if .TopicsEnabled}}<a class="admin-nav-link" href="/admin/topics">{{T "Topics"}}</a>{{end}}
<a class="admin-nav-link" href="/admin/audit">{{T "Audit"}}</a>
<a class="admin-nav-link" href="/admin/regenerate">{{T "Regenerate"}}</a>
</nav>
{{end}}
</aside>
<div class="admin-workspace">
<header class="admin-topbar">
<div>
<p class="admin-kicker">{{T "Control panel"}}</p>
<h1 class="admin-page-title">{{.Title}}</h1>
</div>
<div class="admin-topbar-actions">
<div class="admin-theme-switch" role="group" aria-label="{{T "Theme"}}">
<button type="button" class="admin-theme-option" data-theme-choice="system" aria-pressed="true">{{T "System"}}</button>
<button type="button" class="admin-theme-option" data-theme-choice="light" aria-pressed="false">{{T "Light"}}</button>
<button type="button" class="admin-theme-option" data-theme-choice="dark" aria-pressed="false">{{T "Dark"}}</button>
</div>
<div class="admin-lang-switch" role="group" aria-label="{{T "Language"}}">
<button type="button" class="admin-lang-option" data-lang-choice="en" aria-pressed="{{if eq .Lang "en"}}true{{else}}false{{end}}">EN</button>
<button type="button" class="admin-lang-option" data-lang-choice="es" aria-pressed="{{if eq .Lang "es"}}true{{else}}false{{end}}">ES</button>
</div>
{{if .CSRFToken}}
<form class="admin-logout" method="post" action="/admin/logout">
<input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
<button class="admin-btn admin-btn-ghost" type="submit">{{T "Log out"}}</button>
</form>
{{end}}
</div>
</header>
<main class="admin-main">
{{template "content" .}}
</main>
</div>
</div>
</body>
</html>
{{end}}

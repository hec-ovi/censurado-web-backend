{{define "layout"}}<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{.Title}} | Admin Panel</title>
<meta name="csrf-token" content="{{.CSRFToken}}">
<link rel="stylesheet" href="/admin/assets/admin.css">
<script src="/admin/assets/htmx.min.js" defer></script>
<script src="/admin/assets/theme.js" defer></script>
</head>
<body class="admin-body">
<div class="admin-shell">
<aside class="admin-sidebar" aria-label="Primary">
<a class="admin-brand" href="/admin/articles"><span class="admin-mark">AP</span><span>Admin Panel</span></a>
{{if .CSRFToken}}
<nav class="admin-nav" aria-label="Sections">
<a class="admin-nav-link" href="/admin/articles">Dashboard</a>
<a class="admin-nav-link" href="/admin/create">Create</a>
<a class="admin-nav-link" href="/admin/authors">Authors</a>
<a class="admin-nav-link" href="/admin/topics">Topics</a>
<a class="admin-nav-link" href="/admin/audit">Audit</a>
<a class="admin-nav-link" href="/admin/regenerate">Regenerate</a>
</nav>
{{end}}
</aside>
<div class="admin-workspace">
<header class="admin-topbar">
<div>
<p class="admin-kicker">Control panel</p>
<h1 class="admin-page-title">{{.Title}}</h1>
</div>
<div class="admin-topbar-actions">
<label class="admin-theme-label" for="admin-theme">Theme</label>
<select class="admin-theme-select" id="admin-theme" data-theme-control>
<option value="system">System</option>
<option value="light">Light</option>
<option value="dark">Dark</option>
</select>
{{if .CSRFToken}}
<form class="admin-logout" method="post" action="/admin/logout">
<input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
<button class="admin-btn admin-btn-ghost" type="submit">Log out</button>
</form>
{{end}}
</div>
</header>
<main class="admin-main">
{{template "content" .}}
</main>
</div>
</div>
</body>
</html>
{{end}}

{{define "results"}}
<div class="admin-results">
{{if .Rows}}
<p class="admin-resultcount" aria-live="polite">
{{- .Total}} {{if eq .Total 1}}{{T "article"}}{{else}}{{T "articles"}}{{end}}{{if .Shown}}, {{T "showing"}} {{.FirstIndex}}-{{.LastIndex}}{{end -}}
</p>
<table class="admin-table">
<thead>
<tr><th scope="col">{{T "Title"}}</th><th scope="col">{{T "Author"}}</th><th scope="col">{{T "Section"}}</th><th scope="col">{{T "Topics"}}</th><th scope="col">{{T "Published"}}</th></tr>
</thead>
<tbody>
{{range .Rows}}
<tr>
<td><a class="admin-title-link" href="{{.DetailURL}}">{{.Title}}</a></td>
<td>{{.Author}}</td>
<td>{{.Section}}</td>
<td>{{range $i, $t := .Topics}}{{if $i}}, {{end}}{{$t}}{{end}}</td>
<td>{{.Published}}</td>
</tr>
{{end}}
</tbody>
</table>
<nav class="admin-pager" aria-label="{{T "Pagination"}}">
{{if .HasPrev}}<a class="admin-btn admin-btn-ghost admin-prev" href="{{.PrevURL}}" hx-get="{{.PrevURL}}" hx-target="#results" hx-push-url="true">{{T "Prev"}}</a>{{end}}
<span class="admin-pageinfo">{{T "Page"}} {{.Page}}{{if .TotalPages}} {{T "of"}} {{.TotalPages}}{{end}}</span>
{{if .HasNext}}<a class="admin-btn admin-btn-ghost admin-next" href="{{.NextURL}}" hx-get="{{.NextURL}}" hx-target="#results" hx-push-url="true">{{T "Next"}}</a>{{end}}
</nav>
{{else}}
<p class="admin-empty" aria-live="polite">{{T "No articles match the current filters."}}</p>
{{end}}
</div>
{{end}}

{{define "audit_results"}}
<div class="admin-results">
{{if .Rows}}
<p class="admin-resultcount" aria-live="polite">
{{T "Showing"}} {{.Shown}} {{if eq .Shown 1}}{{T "submission"}}{{else}}{{T "submissions"}}{{end}} ({{T "page"}} {{.Page}})
</p>
<table class="admin-table">
<thead>
<tr><th scope="col">{{T "Created"}}</th><th scope="col">{{T "Author"}}</th><th scope="col">{{T "Slug"}}</th><th scope="col">{{T "Content hash"}}</th><th scope="col">{{T "Scopes"}}</th><th scope="col">{{T "Idempotency key"}}</th></tr>
</thead>
<tbody>
{{range .Rows}}
<tr>
<td class="admin-mono">{{.CreatedAt}}</td>
<td>{{.Author}}</td>
<td><a class="admin-title-link" href="{{.DetailURL}}">{{.Slug}}</a></td>
<td class="admin-mono">{{.ContentHash}}</td>
<td>{{range $i, $s := .Scopes}}{{if $i}}, {{end}}{{$s}}{{end}}</td>
<td class="admin-mono">{{.IdempotencyKey}}</td>
</tr>
{{end}}
</tbody>
</table>
<nav class="admin-pager" aria-label="{{T "Pagination"}}">
{{if .HasPrev}}<a class="admin-btn admin-btn-ghost admin-prev" href="{{.PrevURL}}" hx-get="{{.PrevURL}}" hx-target="#audit-results" hx-push-url="true">{{T "Prev"}}</a>{{end}}
<span class="admin-pageinfo">{{T "Page"}} {{.Page}}</span>
{{if .HasNext}}<a class="admin-btn admin-btn-ghost admin-next" href="{{.NextURL}}" hx-get="{{.NextURL}}" hx-target="#audit-results" hx-push-url="true">{{T "Next"}}</a>{{end}}
</nav>
{{else}}
<p class="admin-empty" aria-live="polite">{{T "No submissions recorded for the current filters."}}</p>
{{end}}
</div>
{{end}}

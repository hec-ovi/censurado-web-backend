# syntax=docker/dockerfile:1
#
# censurado-publish: the authenticated write API (POST /articles + GET /healthz).
# This is the ONLY service that writes the sqlite database. It binds 0.0.0.0 inside
# the container (see the CMD); the compose port mapping pins host exposure to
# 127.0.0.1, so the API stays off the public internet.

# ---- builder ----------------------------------------------------------------
# Builder pinned to an exact Go patch and registry digest for reproducible,
# supply-chain-stable builds (go.mod requires go 1.26). A floating golang:1 tag
# would compile the shipped binary with a different toolchain across rebuilds and
# undercut -trimpath/-ldflags reproducibility. The repo Makefile pins the same
# GO_IMAGE so host and image builds use the identical toolchain. Bump both together;
# re-resolve the digest with `docker buildx imagetools inspect golang:1.26.4-trixie`.
FROM golang:1.26.4-trixie@sha256:792443b89f65105abba56b9bd5e97f680a80074ac62fc844a584212f8c8102c3 AS builder
WORKDIR /src

# Download deps first (cached layer) so source edits do not re-fetch the module graph.
COPY go.mod go.sum ./
RUN go mod download

# Now bring in the source and build a static, cgo-free binary. modernc.org/sqlite is
# pure Go, so CGO_ENABLED=0 produces a fully static binary that needs no libc at runtime.
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" \
        -o /out/censurado-publish ./cmd/censurado/publish

# Seed /data and /srv/media directories owned by the distroless nonroot uid (65532).
# When the db-data and media-data named volumes are first mounted at these paths,
# Docker initializes them with this ownership, so the nonroot process can create and
# write the sqlite file and store uploaded images.
RUN mkdir -p /prep/data /prep/media

# ---- final ------------------------------------------------------------------
# distroless static: no shell, no package manager, ca-certificates + tzdata bundled,
# runs as the nonroot user. Pinned by sha256 digest (preferred for production); the
# :nonroot tag is kept inline for readability. Re-resolve the digest to update.
FROM gcr.io/distroless/static-debian12:nonroot@sha256:d093aa3e30dbadd3efe1310db061a14da60299baff8450a17fe0ccc514a16639

COPY --from=builder /out/censurado-publish /censurado-publish
COPY --from=builder --chown=65532:65532 /prep/data /data
COPY --from=builder --chown=65532:65532 /prep/media /srv/media

USER nonroot:nonroot
EXPOSE 8080

ENTRYPOINT ["/censurado-publish"]
# Bind 0.0.0.0 inside the container so the service is reachable across the compose
# network. The host mapping (127.0.0.1:8080:8080) is what restricts real exposure.
# -db and -keys are supplied via CENSURADO_DB / CENSURADO_PUBLISH_KEYS_FILE in compose.
CMD ["-addr", "0.0.0.0:8080"]

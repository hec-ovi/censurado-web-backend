# Censurado deploy environment. Copy to deploy/.env and fill in real values.
#   cp deploy/.env.example deploy/.env
# NEVER commit deploy/.env or put real secrets in this example file.

# Absolute origin used to build links in the generated static site. Must match where
# the public site is actually served. Read by the external censurado-web generator.
# Example: https://censurado.example
CENSURADO_BASE_URL=https://censurado.example

# --- Litestream backup (optional off-site s3 replica) ------------------------
# The litestream sidecar replicates the sqlite db to a local file replica by
# default (the replica-data volume), which needs NO credentials. For off-site
# backups, uncomment the s3 block in deploy/litestream.yml and set these. They
# work with AWS S3 and S3-compatible stores (Cloudflare R2, Backblaze B2, MinIO).
# Leave them unset/commented when using only the local file replica.
#   LITESTREAM_S3_BUCKET=censurado-backups
#   LITESTREAM_S3_PATH=censurado/db
#   LITESTREAM_S3_REGION=auto
#   # endpoint: set for S3-compatible stores; OMIT (leave blank) for AWS S3.
#   LITESTREAM_S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
#   LITESTREAM_S3_ACCESS_KEY_ID=replace-with-access-key-id
#   LITESTREAM_S3_SECRET_ACCESS_KEY=replace-with-secret-access-key

# The publish API authenticates agents against a keys file at deploy/keys.json
# (mounted read-only into the publish container). It carries only secret HASHES,
# never secrets. Seed the file as an empty JSON array FIRST so the bind mount finds
# a file, not a Docker-created empty directory:
#   printf '[]\n' > deploy/keys.json
# Then mint a key (prints the agent TOKEN once, plus the JSON entry) with:
#   docker compose run --rm publish -gen-key -author NAME -scope articles:write
# Put the printed JSON entry into deploy/keys.json (a JSON array, replacing the []),
# and hand the TOKEN to the agent as CENSURADO_PUBLISH_TOKEN. deploy/keys.json is NOT
# a .env var; it is a file. Do not commit it (it is gitignored).

# syntax=docker/dockerfile:1
#
# censurado-admin: the private operator console (/admin/*). It is a READER of the
# sqlite database (publish is the only writer); writes are proxied to publish over
# the compose network. Static-site generation lives in the censurado-web repo, not
# here. It binds 0.0.0.0 inside the container (see the CMD); the compose port mapping
# pins host exposure to 127.0.0.1, off the public net.

# ---- builder ----------------------------------------------------------------
# Builder pinned to an exact Go patch and registry digest for reproducible,
# supply-chain-stable builds (go.mod requires go 1.26). A floating golang:1 tag
# would compile the shipped binary with a different toolchain across rebuilds and
# undercut -trimpath/-ldflags reproducibility. The repo Makefile pins the same
# GO_IMAGE so host and image builds use the identical toolchain. Bump both together;
# re-resolve the digest with `docker buildx imagetools inspect golang:1.26.4-trixie`.
FROM golang:1.26.4-trixie@sha256:792443b89f65105abba56b9bd5e97f680a80074ac62fc844a584212f8c8102c3 AS builder
WORKDIR /src

# Download deps first (cached layer) so source edits do not re-fetch the module graph.
COPY go.mod go.sum ./
RUN go mod download

# Static, cgo-free build (modernc.org/sqlite is pure Go, so no libc is needed).
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" \
        -o /out/censurado-admin ./cmd/censurado/admin

# Seed /data (shared db volume, mounted rw because WAL readers touch -shm/-wal)
# owned by the distroless nonroot uid (65532) so the named volume initializes
# writable for the nonroot process.
RUN mkdir -p /prep/data

# ---- final ------------------------------------------------------------------
# distroless static: no shell, no package manager, ca-certificates + tzdata bundled,
# runs as the nonroot user. Pinned by sha256 digest (preferred for production); the
# :nonroot tag is kept inline for readability. Re-resolve the digest to update.
FROM gcr.io/distroless/static-debian12:nonroot@sha256:d093aa3e30dbadd3efe1310db061a14da60299baff8450a17fe0ccc514a16639

COPY --from=builder /out/censurado-admin /censurado-admin
COPY --from=builder --chown=65532:65532 /prep/data /data

USER nonroot:nonroot
EXPOSE 8081

ENTRYPOINT ["/censurado-admin"]
# Bind 0.0.0.0 inside the container so the console is reachable across the compose
# network. The host mapping (127.0.0.1:8081:8081) is what restricts real exposure.
# Credentials and -db come from the environment in compose.
CMD ["-addr", "0.0.0.0:8081"]
